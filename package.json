{
  "name": "taishan-vision",
  "description": "泰山识图 Taishan Vision - 让 DeepSeek Harness 纯文本模型也能识图:GLM 视觉识别 + 所选模型推理(静态插件包,重启永久生效)",
  "version": "5.0",
  "private": false,
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "banner.png"
  ],
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "vision",
    "image-recognition",
    "zhipu",
    "glm",
    "免费识图"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT"
}
